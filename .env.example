# ============================================================
#  Credenciales y configuración sensible
#  1) Copia este archivo a ".env":   cp .env.example .env
#  2) Rellena tus claves de la TESTNET (NUNCA las de producción)
#  3) El archivo .env está en .gitignore: jamás se sube al repo
# ============================================================

# --- Binance SPOT Testnet ---
# Genera estas claves en: https://testnet.binance.vision/
#   -> "Log In with GitHub" -> "Generate HMAC_SHA256 Key"
BINANCE_TESTNET_API_KEY=pega_aqui_tu_api_key
BINANCE_TESTNET_API_SECRET=pega_aqui_tu_api_secret

# --- Seguridad ---
# Deja SIEMPRE en "testnet". Solo "live" usaría dinero REAL (no implementado
# por seguridad). El código aborta si detecta "live" sin confirmación expresa.
TRADING_MODE=testnet
